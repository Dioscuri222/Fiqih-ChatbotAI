<%- include('partials/head', { judul: judul }) %>
<body class="bg-kabut text-tinta font-sans antialiased">

  <header class="max-w-5xl mx-auto px-6 py-6 flex items-center justify-between">
    <a href="/" class="text-xl font-extrabold tracking-tight"><%= namaToko %></a>
    <nav class="flex gap-5 text-sm font-semibold">
      <a href="#produk" class="hover:underline focus-visible:underline">Produk</a>
      <a href="/api/produk" class="hover:underline focus-visible:underline">API produk</a>
      <a href="/api/status" class="hover:underline focus-visible:underline">API status</a>
    </nav>
  </header>

  <main>
    <!-- Hero -->
    <section class="max-w-5xl mx-auto px-6 pt-10 pb-20 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold leading-[1.05] tracking-tight">
          Kopi dari lereng Merapi, langsung ke cangkirmu.
        </h1>
        <p class="mt-6 text-lg max-w-md text-tinta/80">
          Biji pilihan petani Sleman dan Temanggung, disangrai dalam batch kecil setiap minggu.
        </p>
        <a href="#produk"
           class="inline-block mt-8 bg-tinta text-kabut font-semibold rounded-md px-6 py-3 hover:bg-tinta/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tinta">
          Lihat produk
        </a>
      </div>

      <!-- Respons asli dari /api/status -->
      <div class="bg-tinta text-kabut rounded-lg p-6 font-mono text-sm shadow-lg">
        <div class="flex items-center justify-between mb-4">
          <span class="font-semibold">GET /api/status</span>
          <span class="flex items-center gap-2">
            <span id="status-dot" class="h-2.5 w-2.5 rounded-full bg-kabut/40"></span>
            <span id="status-label">Menghubungi server</span>
          </span>
        </div>
        <pre id="status-output" class="whitespace-pre-wrap break-words text-madu min-h-[8rem]">...</pre>
      </div>
    </section>

    <!-- Produk -->
    <section id="produk" class="max-w-5xl mx-auto px-6 pb-20 scroll-mt-6">
      <h2 class="text-3xl font-extrabold tracking-tight">Produk minggu ini</h2>
      <p class="mt-2 text-tinta/70">Data diambil dari <code class="font-mono text-sm">models/produkModel.js</code>.</p>

      <ul class="mt-8 divide-y divide-tinta/20 border-y border-tinta/20">
        <% produk.forEach(function (p) { %>
          <li class="py-5 flex items-start justify-between gap-6">
            <div>
              <h3 class="text-lg font-semibold"><%= p.nama %></h3>
              <p class="text-tinta/70 max-w-md"><%= p.deskripsi %></p>
              <p class="mt-1 text-sm text-tinta/60"><%= p.kategori %></p>
            </div>
            <div class="text-right shrink-0">
              <p class="text-lg font-extrabold">Rp <%= p.harga.toLocaleString('id-ID') %></p>
              <p class="text-sm text-tinta/60">Stok <%= p.stok %></p>
            </div>
          </li>
        <% }); %>
      </ul>
    </section>
  </main>

  <script>
    (async function () {
      const output = document.getElementById('status-output');
      const label = document.getElementById('status-label');
      const dot = document.getElementById('status-dot');

      try {
        const res = await fetch('/api/status');
        const data = await res.json();
        output.textContent = JSON.stringify(data, null, 2);
        label.textContent = 'Server berjalan';
        dot.className = 'h-2.5 w-2.5 rounded-full bg-madu motion-safe:animate-pulse';
      } catch (err) {
        output.textContent = 'Gagal menghubungi /api/status. Pastikan server masih berjalan.';
        label.textContent = 'Tidak terhubung';
      }
    })();
  </script>

<%- include('partials/footer') %>
