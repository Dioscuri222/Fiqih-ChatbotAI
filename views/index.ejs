<%- include('partials/head', { judul: judul }) %>
<%- include('partials/navbar') %>

<main class="flex-1 pb-16">
  <!-- HERO SECTION -->
  <section class="bg-gradient-to-b from-scholar-900 to-scholar-950 text-white pt-12 pb-16 px-4 sm:px-6 lg:px-8 border-b border-scholar-800">
    <div class="max-w-6xl mx-auto grid lg:grid-cols-12 gap-8 items-center">
      
      <!-- Kolom Kiri: Pengantar Proyek & Metode Waterfall -->
      <div class="lg:col-span-7 space-y-5">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-scholar-800/80 border border-scholar-700 text-xs text-amber-300 font-medium">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          PPAW Week 7 • Integrasi Frontend, REST API, & Logger
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
          Asisten Tanya Jawab & Rujukan <span class="text-amber-400">Fiqih Kontemporer</span>
        </h1>

        <p class="text-slate-300 text-base sm:text-lg leading-relaxed max-w-2xl">
          Platform web berbasis Express.js MVC terintegrasi model Gemini AI dan korpus fatwa Syekh Yusuf Al-Qardhawi. Dirancang untuk menjawab problematika muamalah, zakat, medis modern, dan gaya hidup kontemporer secara berdalil.
        </p>

        <!-- Rationale Metode Waterfall -->
        <div class="bg-scholar-800/60 border-l-4 border-amber-400 p-4 rounded-r-lg text-xs sm:text-sm text-slate-300 leading-normal">
          <p class="font-semibold text-white mb-1 flex items-center gap-2">
            <svg class="w-4 h-4 text-amber-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd"/>
            </svg>
            Metode Rekayasa Perangkat Lunak: Waterfall (Kelas E)
          </p>
          <p>
            Kami memilih metode Waterfall karena alur kerjanya linier dan terstruktur, sehingga spesifikasi sistem dapat dikunci di awal untuk mencegah pembesaran yang tidak diinginkan pada ruang lingkup (scope creep).
          </p>
        </div>

        <div class="flex flex-wrap gap-3 pt-2">
          <a href="#produk" class="bg-emeraldFiqih-700 hover:bg-emeraldFiqih-600 text-white font-semibold text-sm px-5 py-2.5 rounded-lg shadow-sm transition-all focus:ring-2 focus:ring-emerald-400">
            Jelajahi Modul Fiqih
          </a>
          <a href="#tester" class="bg-scholar-800 hover:bg-scholar-700 text-slate-200 border border-scholar-700 font-semibold text-sm px-5 py-2.5 rounded-lg transition-all">
            Uji Endpoint API
          </a>
        </div>
      </div>

      <!-- Kolom Kanan: Live Server Status Card (Terhubung ke GET /api/status) -->
      <div class="lg:col-span-5">
        <div class="bg-scholar-900 border border-scholar-700 rounded-xl p-5 shadow-xl font-mono text-xs text-slate-300">
          <div class="flex items-center justify-between pb-3 border-b border-scholar-800">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 -ml-4"></span>
              <span class="font-bold text-white text-sm">Status Endpoint Live</span>
            </div>
            <button id="btn-refresh-status" class="text-[11px] bg-scholar-800 hover:bg-scholar-700 text-slate-300 hover:text-white px-2.5 py-1 rounded border border-scholar-700 transition">
              Refresh
            </button>
          </div>

          <div class="mt-3 flex items-center justify-between text-[11px] text-slate-400">
            <span>Route: <strong class="text-amber-300">GET /api/status</strong></span>
            <span id="hero-status-pill" class="px-2 py-0.5 rounded text-[10px] bg-emerald-950 text-emerald-300 border border-emerald-800">
              Memeriksa...
            </span>
          </div>

          <!-- JSON Live Output -->
          <div class="mt-3 bg-scholar-950 border border-scholar-800 rounded-lg p-3 overflow-x-auto">
            <pre id="hero-status-json" class="text-emerald-400 text-[11px] leading-tight">Menghubungkan ke /api/status...</pre>
          </div>

          <div class="mt-3 pt-3 border-t border-scholar-800/80 flex items-center justify-between text-[10px] text-slate-400">
            <span>Uptime: <span id="hero-uptime" class="text-white">-</span></span>
            <span>Logger: <span class="text-emerald-400 font-semibold">Tercatat di Terminal</span></span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- INTERACTIVE API PLAYGROUND & MIDDLEWARE LOGGER TESTER -->
  <section id="tester" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6">
    <div class="bg-white rounded-xl shadow-md border border-slate-200 p-6">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-5 border-b border-slate-100">
        <div>
          <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
            <span>Interactive REST API Playground</span>
            <span class="text-xs font-mono font-medium bg-blue-100 text-blue-800 px-2.5 py-0.5 rounded-full">
              PPAW Tugas 2 & 3
            </span>
          </h2>
          <p class="text-sm text-slate-500 mt-1">
            Uji endpoint secara langsung dari browser. Setiap permintaan HTTP akan otomatis ditangkap dan dicatat oleh <code>middlewares/logger.js</code>.
          </p>
        </div>

        <!-- Tombol Aksi Cepat -->
        <div class="flex flex-wrap items-center gap-2">
          <button id="btn-call-status" class="px-3.5 py-2 text-xs font-semibold rounded-lg bg-scholar-800 text-white hover:bg-scholar-900 transition flex items-center gap-1.5 shadow-sm">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            GET /api/status
          </button>
          <button id="btn-call-produk" class="px-3.5 py-2 text-xs font-semibold rounded-lg bg-emeraldFiqih-700 text-white hover:bg-emeraldFiqih-800 transition flex items-center gap-1.5 shadow-sm">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            GET /api/produk
          </button>
          <button id="btn-call-produk-array" class="px-3 py-2 text-xs font-semibold rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 border border-slate-300 transition">
            Raw Array (?format=array)
          </button>
        </div>
      </div>

      <!-- Kotak Hasil Output Konsol API -->
      <div class="mt-5">
        <div class="flex items-center justify-between bg-slate-900 text-slate-300 px-4 py-2 rounded-t-lg text-xs font-mono">
          <div class="flex items-center gap-2">
            <span class="text-slate-400">Endpoint Aktif:</span>
            <span id="api-active-url" class="text-amber-400 font-bold">/api/status</span>
            <span id="api-http-badge" class="px-2 py-0.5 rounded bg-emerald-900 text-emerald-300 text-[10px] font-semibold">HTTP 200 OK</span>
          </div>
          <span id="api-response-time" class="text-slate-400 text-[11px]">- ms</span>
        </div>
        <div class="bg-slate-950 p-4 rounded-b-lg border border-slate-900 font-mono text-xs overflow-x-auto max-h-72">
          <pre id="api-console-output" class="text-slate-200 whitespace-pre-wrap">Klik salah satu tombol endpoint di atas untuk melakukan HTTP request...</pre>
        </div>
      </div>
    </div>
  </section>

  <!-- KATALOG MODUL & RUJUKAN FIQIH KONTEMPORER (MODELS MVC) -->
  <section id="produk" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-16">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
      <div>
        <div class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-emeraldFiqih-700 mb-1">
          <span>Struktur MVC — Model Layer</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Katalog Modul & Rujukan Fiqih
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-1 max-w-2xl">
          Data berikut dikelola secara terpusat oleh <code class="text-xs bg-slate-200 px-1.5 py-0.5 rounded font-mono text-slate-800">models/produkModel.js</code> dan dirender secara dinamis melalui View Engine EJS.
        </p>
      </div>

      <div class="flex items-center gap-2 text-xs font-mono bg-slate-100 text-slate-600 px-3 py-1.5 rounded-lg border border-slate-200">
        <span>Total Modul Tersedia:</span>
        <strong class="text-slate-900"><%= produk.length %> Item</strong>
      </div>
    </div>

    <!-- Grid Produk / Modul Fiqih -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% produk.forEach(function (item) { %>
        <article class="bg-white rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between overflow-hidden group">
          <div class="p-5">
            <!-- Header Kartu: Kategori & Format -->
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-[11px] font-semibold px-2.5 py-1 rounded-md bg-emerald-50 text-emeraldFiqih-800 border border-emerald-200">
                <%= item.kategori %>
              </span>
              <span class="text-[11px] font-mono text-slate-500">
                <%= item.format || 'Digital' %>
              </span>
            </div>

            <!-- Judul Modul / Kitab -->
            <h3 class="text-lg font-bold text-slate-900 group-hover:text-emeraldFiqih-700 transition-colors leading-snug">
              <%= item.nama %>
            </h3>

            <!-- Penulis / Rujukan Utama -->
            <p class="text-xs text-amber-600 font-medium mt-1">
              Rujukan: <%= item.penulis || 'Pakar Fiqih Kontemporer' %>
            </p>

            <!-- Deskripsi -->
            <p class="text-xs text-slate-600 mt-2.5 leading-relaxed line-clamp-3">
              <%= item.deskripsi %>
            </p>
          </div>

          <!-- Footer Kartu: Harga & Stok -->
          <div class="px-5 py-3.5 bg-slate-50 border-t border-slate-100 flex items-center justify-between mt-2">
            <div>
              <p class="text-[11px] text-slate-500">Nilai Modul</p>
              <p class="text-base font-extrabold text-slate-900">
                <%= utils.formatRupiah(item.harga) %>
              </p>
            </div>
            <div class="text-right">
              <span class="inline-block text-[11px] font-medium px-2 py-0.5 rounded bg-slate-200 text-slate-700">
                Stok <%= item.stok %>
              </span>
            </div>
          </div>
        </article>
      <% }); %>
    </div>
  </section>

  <!-- TENTANG ARSITEKTUR & TIM KELAS E -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-16">
    <div class="bg-scholar-900 text-white rounded-2xl p-6 sm:p-8 border border-scholar-800 shadow-lg">
      <div class="grid md:grid-cols-3 gap-6 text-sm">
        <div class="space-y-2">
          <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center font-bold">
            1
          </div>
          <h4 class="font-bold text-white text-base">Arsitektur MVC Terpisah</h4>
          <p class="text-slate-300 text-xs leading-relaxed">
            Pemisahan tanggung jawab yang jelas antara Controller (routing logic), Model (data abstraction), View (template EJS), Middleware (logger request), dan Utils (helper format).
          </p>
        </div>

        <div class="space-y-2">
          <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold">
            2
          </div>
          <h4 class="font-bold text-white text-base">Middleware Logger Real-Time</h4>
          <p class="text-slate-300 text-xs leading-relaxed">
            Mencatat setiap HTTP Method, endpoint yang dituju, status respon HTTP, durasi eksekusi millisecond, dan timestamp ke console backend serta disimpan ke <code>logs/logger.md</code>.
          </p>
        </div>

        <div class="space-y-2">
          <div class="w-8 h-8 rounded-lg bg-blue-500/20 text-blue-400 flex items-center justify-center font-bold">
            3
          </div>
          <h4 class="font-bold text-white text-base">Fondasi Proyek Berkelanjutan</h4>
          <p class="text-slate-300 text-xs leading-relaxed">
            Dirancang untuk dilanjutkan pada perkuliahan PPAW berikutnya, mengintegrasikan RAG (Retrieval-Augmented Generation) Gemini AI dengan data fatwa fiqih kontemporer.
          </p>
        </div>
      </div>
    </div>
  </section>
</main>

<!-- CLIENT JAVASCRIPT: TESTER API & LIVE STATUS -->
<script>
  (function () {
    const heroOutput = document.getElementById('hero-status-json');
    const heroPill = document.getElementById('hero-status-pill');
    const heroUptime = document.getElementById('hero-uptime');
    const btnRefresh = document.getElementById('btn-refresh-status');

    const consoleOutput = document.getElementById('api-console-output');
    const activeUrlLabel = document.getElementById('api-active-url');
    const httpBadge = document.getElementById('api-http-badge');
    const responseTimeLabel = document.getElementById('api-response-time');

    const btnCallStatus = document.getElementById('btn-call-status');
    const btnCallProduk = document.getElementById('btn-call-produk');
    const btnCallProdukArray = document.getElementById('btn-call-produk-array');

    // Fungsi fetch status server untuk Hero
    async function fetchHeroStatus() {
      try {
        heroPill.textContent = 'Memeriksa...';
        heroPill.className = 'px-2 py-0.5 rounded text-[10px] bg-slate-800 text-slate-300';
        
        const res = await fetch('/api/status');
        const data = await res.json();
        
        heroOutput.textContent = JSON.stringify(data, null, 2);
        heroPill.textContent = 'Server Online';
        heroPill.className = 'px-2 py-0.5 rounded text-[10px] bg-emerald-950 text-emerald-300 border border-emerald-700';
        if (data.uptimeDetik !== undefined) {
          heroUptime.textContent = data.uptimeDetik + ' detik';
        }
      } catch (err) {
        heroOutput.textContent = 'Gagal menghubungi /api/status. Pastikan server aktif.';
        heroPill.textContent = 'Offline';
        heroPill.className = 'px-2 py-0.5 rounded text-[10px] bg-rose-950 text-rose-300 border border-rose-700';
      }
    }

    // Fungsi umum untuk tester playground
    async function testEndpoint(url) {
      activeUrlLabel.textContent = url;
      consoleOutput.textContent = 'Mengirim HTTP GET ' + url + ' ...';
      httpBadge.textContent = 'Requesting...';
      httpBadge.className = 'px-2 py-0.5 rounded bg-slate-800 text-slate-300 text-[10px] font-semibold';
      responseTimeLabel.textContent = '...';

      const t0 = performance.now();
      try {
        const res = await fetch(url);
        const t1 = performance.now();
        const duration = (t1 - t0).toFixed(1);
        const json = await res.json();

        httpBadge.textContent = 'HTTP ' + res.status + ' ' + (res.ok ? 'OK' : 'Error');
        httpBadge.className = res.ok
          ? 'px-2 py-0.5 rounded bg-emerald-900 text-emerald-300 text-[10px] font-semibold'
          : 'px-2 py-0.5 rounded bg-rose-900 text-rose-300 text-[10px] font-semibold';

        responseTimeLabel.textContent = duration + ' ms';
        consoleOutput.textContent = JSON.stringify(json, null, 2);
      } catch (err) {
        httpBadge.textContent = 'Fetch Error';
        httpBadge.className = 'px-2 py-0.5 rounded bg-rose-900 text-rose-300 text-[10px] font-semibold';
        consoleOutput.textContent = 'Terjadi kesalahan saat memanggil endpoint: ' + err.message;
      }
    }

    btnRefresh.addEventListener('click', fetchHeroStatus);
    btnCallStatus.addEventListener('click', () => testEndpoint('/api/status'));
    btnCallProduk.addEventListener('click', () => testEndpoint('/api/produk'));
    btnCallProdukArray.addEventListener('click', () => testEndpoint('/api/produk?format=array'));

    // Jalankan pertama kali saat halaman dimuat
    fetchHeroStatus();
  })();
</script>

<%- include('partials/footer') %>
